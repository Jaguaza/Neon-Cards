{
  "name": "neon-cards",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Paquete de tarjetas Lovelace personalizadas para Home Assistant, con estética neón.",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "npm run build:ts && npm run build:cards",
    "build:ts": "tsc -b",
    "build:cards": "rollup -c",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --build",
    "test": "echo \"(sin tests todavía)\" && exit 0",
    "perf": "node --expose-gc scripts/perf-check.mjs",
    "release:beta": "node scripts/release.js beta",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "eslint": "^9.9.0",
    "jsdom": "^30.0.1",
    "rollup": "^4.21.0",
    "tslib": "^2.6.3",
    "typescript": "^5.5.4"
  },
  "license": "Apache-2.0"
}
